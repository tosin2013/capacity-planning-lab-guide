---
# ===================================================================
# AgnosticD Secrets File — capacity planning workshop
# ===================================================================
# Copy to: ~/agnosticd-v2-secrets/secrets-<ACCOUNT>.yml
# e.g.:    ~/agnosticd-v2-secrets/secrets-sandbox1234.yml
#          ~/agnosticd-v2-secrets/secrets-mycompany.yml
#
# NEVER commit this file with real credentials.
# ===================================================================

# ── Option A: RHDP Open Environment ──────────────────────────────
# Order a sandbox at:
#   https://catalog.demo.redhat.com/catalog/babylon-catalog-prod?item=babylon-catalog-prod/sandboxes-gpte.sandbox-open.prod
# Credentials and base_domain are emailed to you after the sandbox is ready.
#
# aws_access_key_id: "<ACCESS_KEY from RHDP email>"
# aws_secret_access_key: "<SECRET_KEY from RHDP email>"
# base_domain: "sandbox<N>.opentlc.com"

# ── Option B: Own AWS account ─────────────────────────────────────
# Requires a Route 53 public hosted zone for cluster DNS.
# Quota increases must be requested before provisioning (see docs/hub-student-deployment.md).
#
# aws_access_key_id: "AKIA..."
# aws_secret_access_key: "..."
# base_domain: "mycompany.example.com"   # Route 53 public hosted zone

# ── Fill in ONE of the above options (uncomment and set values): ──
aws_access_key_id: "<YOUR_ACCESS_KEY>"
aws_secret_access_key: "<YOUR_SECRET_KEY>"
base_domain: "<YOUR_BASE_DOMAIN>"

# ===================================================================
# Required: OpenShift Pull Secret
# ===================================================================
# Needed by the OCP installer to pull images from Red Hat registries.
# Get yours at: https://console.redhat.com/openshift/install/pull-secret
# Paste the entire JSON blob (single line) between the single quotes.
ocp4_pull_secret: '<YOUR_PULL_SECRET_JSON>'

# ===================================================================
# Optional: Module 8 — OpenShift Lightspeed
# ===================================================================
# Get a virtual key from the RHDP LiteMaaS portal.
# Set here; reference in student var files as:
#   ocp4_workload_lightspeed_litemaas_api_token: "{{ ocp4_workload_lightspeed_litemaas_api_token }}"
# ocp4_workload_lightspeed_litemaas_api_token: "sk-..."
